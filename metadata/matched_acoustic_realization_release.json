{
  "release": "RefCon-T2A matched acoustic-realization evaluation materials v1",
  "scope": "Evaluation data card; not a model or training-data release.",
  "construction": {
    "source_anchor": "One held-out VGGSound anchor per group; source videos are not redistributed.",
    "endpoint_generation": "Text-guided MMAudio endpoint rendering with the anchor and generation seed held fixed within a group.",
    "selection_before_ac_t2a_generation": true,
    "candidate_groups": 30,
    "selected_groups": 22,
    "rejected_groups": 8,
    "minimum_endpoint_duration_sec": 7.9,
    "minimum_endpoint_CLAP_distance": 0.15,
    "reference_crop_sec": 5.0,
    "sample_rate_hz": 44100,
    "pairwise_RMS_matching": true
  },
  "ac_t2a_protocol": {
    "cells_per_group": 4,
    "cells": [
      "text_A/reference_A",
      "text_A/reference_B",
      "text_B/reference_A",
      "text_B/reference_B"
    ],
    "no_reference_controls_per_group": 2,
    "fixed_generation_seeds": [
      3,
      4
    ],
    "video_at_AC_T2A_inference": false
  },
  "limitations": [
    "Endpoints can differ in source identity as well as acoustic realization; this is not a pure-timbre benchmark.",
    "MMAudio constructs the endpoints and is the backbone family adapted by RefCon-T2A; results are condition-allocation evidence, not an unbiased cross-architecture quality rank.",
    "Automatic endpoint movement is not a perceptual listening-study score."
  ],
